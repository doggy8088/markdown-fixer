{
  "comment": "CLI golden 案例清單。scripts/gen-cli-golden.mjs 依此在暫存目錄執行 oracle CLI，輸出寫到 tests/cli-golden/cases/。fixture 路徑相對於 crates/markdown-fixer-cli/tests/fixtures/。",
  "presets": {
    "tree": [
      { "path": "README.md", "fixture": "messy.md" },
      { "path": "clean.md", "fixture": "clean.md" },
      { "path": "notes.txt", "fixture": "notes.txt" },
      { "path": "docs/guide.MD", "fixture": "zh-doc.md" },
      { "path": "docs/intro.markdown", "fixture": "info.md" },
      { "path": "docs/page.mdx", "text": "#Skipped mdx\n" },
      { "path": "docs/deep/long.md", "fixture": "long.md" },
      { "path": "docs/link.md", "symlink": "../README.md" },
      { "path": "docs/dirlink", "symlink": "deep" },
      { "path": "node_modules/pkg/README.md", "text": "#Excluded\n" },
      { "path": ".git/notes.md", "text": "#Excluded\n" },
      { "path": "vendor/x.md", "text": "#Excluded\n" },
      { "path": "docs/coverage/report.md", "text": "#Excluded\n" },
      { "path": "test-results/a.md", "text": "#Excluded\n" },
      { "path": "playwright-report/a.md", "text": "#Excluded\n" },
      { "path": "blob-report/a.md", "text": "#Excluded\n" },
      { "path": ".e2e-tmp/a.md", "text": "#Excluded\n" },
      { "path": ".hg/a.md", "text": "#Excluded\n" },
      { "path": ".svn/a.md", "text": "#Excluded\n" }
    ]
  },
  "cases": [
    { "name": "version", "args": ["--version"] },
    { "name": "version-short", "args": ["-v"] },
    { "name": "help", "args": ["--help"] },
    { "name": "help-short", "args": ["-h", "--list-rules"] },
    { "name": "list-rules", "args": ["--list-rules"] },
    { "name": "unknown-option", "args": ["--bogus"] },
    { "name": "unknown-option-after-help", "args": ["--help", "--bogus"] },
    { "name": "unknown-option-single-dash", "args": ["-"] },
    { "name": "unknown-option-with-value", "args": ["--check=yes"] },
    { "name": "rule-missing-value", "args": ["--rule"] },
    { "name": "rule-consumes-next-flag", "args": ["--rule", "--json"] },
    { "name": "rule-unknown", "args": ["--rule=MDX010,NOPE"] },
    { "name": "ignore-rule-empty-list", "args": ["--ignore-rule", " , "] },
    { "name": "max-line-length-zero", "args": ["--max-line-length", "0"] },
    { "name": "max-line-length-fraction", "args": ["--max-line-length=8.5"] },
    { "name": "max-line-length-missing", "args": ["--max-line-length"] },
    { "name": "write-without-paths", "args": ["--write"] },
    { "name": "write-without-paths-json", "args": ["--write", "--json"] },

    { "name": "check-default-cwd", "setup": ["@tree"], "args": [] },
    { "name": "check-default-cwd-json", "setup": ["@tree"], "args": ["--json"] },
    { "name": "check-directory", "setup": ["@tree"], "args": ["--check", "docs"] },
    { "name": "check-directory-quiet", "setup": ["@tree"], "args": ["--quiet", "docs/"] },
    { "name": "write-directory", "setup": ["@tree"], "args": ["--write", "./docs", "README.md"] },
    { "name": "write-directory-json", "setup": ["@tree"], "args": ["--write", "--json", "."] },
    { "name": "explicit-non-markdown-file", "setup": ["@tree"], "args": ["notes.txt", "docs/page.mdx"] },
    { "name": "explicit-excluded-directory", "setup": ["@tree"], "args": ["node_modules"] },
    { "name": "dedupe-inputs", "setup": ["@tree"], "args": ["--quiet", "README.md", "./README.md", "docs/../README.md", "docs/link.md", "."] },
    { "name": "outside-cwd", "setup": ["@tree"], "cwd": "docs/deep", "args": ["../../README.md", "..", "long.md"] },
    { "name": "double-dash", "setup": [{ "path": "--weird.md", "fixture": "info.md" }], "args": ["--strict", "--", "--weird.md"] },

    { "name": "check-messy", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--check", "messy.md"] },
    { "name": "check-messy-json", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--json", "messy.md"] },
    { "name": "check-messy-quiet", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--quiet", "messy.md"] },
    { "name": "write-messy", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--write", "messy.md"] },
    { "name": "write-messy-json", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--json", "--write", "messy.md"] },
    { "name": "write-messy-quiet", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--write", "--quiet", "messy.md"] },
    { "name": "write-then-check", "setup": [{ "path": "zh-doc.md", "fixture": "zh-doc.md" }], "args": ["--write", "--check", "zh-doc.md"] },
    { "name": "write-zh-doc", "setup": [{ "path": "zh-doc.md", "fixture": "zh-doc.md" }], "args": ["--write", "zh-doc.md"] },
    { "name": "write-zh-doc-strict", "setup": [{ "path": "zh-doc.md", "fixture": "zh-doc.md" }], "args": ["--write", "--strict", "--json", "zh-doc.md"] },
    { "name": "check-clean", "setup": [{ "path": "clean.md", "fixture": "clean.md" }], "args": ["clean.md"] },
    { "name": "write-clean", "setup": [{ "path": "clean.md", "fixture": "clean.md" }], "args": ["--write", "clean.md"] },
    { "name": "info-not-strict", "setup": [{ "path": "info.md", "fixture": "info.md" }], "args": ["info.md"] },
    { "name": "info-strict", "setup": [{ "path": "info.md", "fixture": "info.md" }], "args": ["--strict", "info.md"] },
    { "name": "info-strict-write", "setup": [{ "path": "info.md", "fixture": "info.md" }], "args": ["--strict", "--write", "info.md"] },

    { "name": "rule-filter", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--rule", "MDX010,MDX004", "messy.md"] },
    { "name": "rule-filter-write", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--write", "--rule= MDX010 ,MDX013", "--rule", "MDX003", "messy.md"] },
    { "name": "ignore-rule-write", "setup": [{ "path": "messy.md", "fixture": "messy.md" }], "args": ["--ignore-rule=MDX004", "--ignore-rule", "MDX005,MDX042", "--write", "messy.md"] },
    { "name": "rule-mdx090-default-limit", "setup": [{ "path": "long.md", "fixture": "long.md" }], "args": ["--rule", "MDX090", "long.md"] },
    { "name": "max-line-length", "setup": [{ "path": "long.md", "fixture": "long.md" }], "args": ["--max-line-length=40", "--json", "long.md"] },
    { "name": "max-line-length-js-number", "setup": [{ "path": "long.md", "fixture": "long.md" }], "args": ["--max-line-length", " 0x28 ", "--strict", "long.md"] },
    { "name": "max-line-length-exponent", "setup": [{ "path": "long.md", "fixture": "long.md" }], "args": ["--max-line-length=5e1", "long.md"] },

    { "name": "refused-check", "setup": [{ "path": "fm.md", "fixture": "frontmatter-unclosed.md" }], "args": ["fm.md"] },
    { "name": "refused-check-json", "setup": [{ "path": "fm.md", "fixture": "frontmatter-unclosed.md" }], "args": ["--check", "--json", "fm.md"] },
    { "name": "refused-write", "setup": [{ "path": "fm.md", "fixture": "frontmatter-unclosed.md" }], "args": ["--write", "fm.md"] },
    { "name": "refused-write-quiet", "setup": [{ "path": "fm.md", "fixture": "frontmatter-unclosed.md" }], "args": ["--write", "--quiet", "fm.md"] },
    { "name": "refused-html-comment-write-json", "setup": [{ "path": "c.md", "fixture": "html-comment-unclosed.md" }], "args": ["--write", "--json", "c.md"] },
    { "name": "frontmatter-trap-write", "setup": [{ "path": "trap.md", "fixture": "frontmatter-trap.md" }, { "path": "ok.md", "fixture": "messy.md" }], "args": ["--write", "trap.md", "ok.md"] },
    { "name": "fence-unclosed-write", "setup": [{ "path": "f.md", "fixture": "fence-unclosed.md" }], "args": ["--write", "f.md"] },
    { "name": "crlf-bom-write", "setup": [{ "path": "w.md", "fixture": "crlf-bom.md" }], "args": ["--write", "w.md"] },
    { "name": "crlf-bom-preserved", "setup": [{ "path": "w.md", "fixture": "crlf-bom.md" }], "args": ["--write", "--ignore-rule", "MDX001,MDX002", "w.md"] },
    { "name": "crlf-bom-nothing-else", "setup": [{ "path": "w.md", "text": "﻿# Title\r\n" }], "args": ["--write", "--json", "--ignore-rule=MDX001,MDX002", "w.md"] },

    { "name": "missing-path", "setup": [{ "path": "a.md", "fixture": "clean.md" }], "args": ["missing.md", "a.md", "also-missing/"] },
    { "name": "not-a-directory", "setup": [{ "path": "a.md", "fixture": "clean.md" }], "args": ["a.md/"] },
    { "name": "no-markdown-files", "setup": [{ "path": "empty", "dir": true }, { "path": "other/x.txt", "text": "x\n" }], "args": ["empty", "other"] },
    { "name": "no-markdown-files-json", "setup": [{ "path": "empty", "dir": true }], "args": ["--write", "--json", "empty"] },
    { "name": "invalid-utf8-and-good", "setup": [{ "path": "good.md", "fixture": "clean.md" }, { "path": "bad.md", "hex": "fffe2320" }], "args": ["--check", "good.md", "bad.md"] },
    { "name": "invalid-utf8-json", "setup": [{ "path": "good.md", "fixture": "messy.md" }, { "path": "bad.md", "hex": "fffe" }], "args": ["--json", "--write", "."] },
    { "name": "nul-bytes", "setup": [{ "path": "nul.md", "text": "# Title\u0000\n" }], "args": ["--check", "nul.md"] },
    { "name": "all-unreadable-text", "setup": [{ "path": "bad.md", "hex": "c3" }], "args": ["bad.md"] },
    { "name": "all-unreadable-json", "setup": [{ "path": "bad.md", "hex": "c3" }], "args": ["--json", "bad.md"] },
    { "name": "symlink-write", "setup": [{ "path": "target.md", "text": "#Title\n" }, { "path": "link.md", "symlink": "target.md" }], "args": ["--write", "link.md"] },
    { "name": "sort-utf16", "setup": [
        { "path": "～.md", "text": "#Fullwidth tilde\n" },
        { "path": "😀.md", "text": "#Emoji\n" },
        { "path": "b.md", "text": "#b\n" },
        { "path": "_.md", "text": "#underscore\n" },
        { "path": "Z.md", "text": "#Z\n" },
        { "path": "中文.md", "text": "#CJK\n" }
      ], "args": ["--quiet", "--json", "."] },
    { "name": "sort-utf16-text", "setup": [
        { "path": "～.md", "text": "# Fullwidth tilde\n" },
        { "path": "😀.md", "text": "# Emoji\n" },
        { "path": "b.md", "text": "# b\n" }
      ], "args": ["."] },
    { "name": "unreadable-directory", "nonRoot": true, "setup": [{ "path": "b", "dir": true, "mode": "000" }, { "path": "a", "dir": true, "mode": "000" }, { "path": "C", "dir": true, "mode": "000" }, { "path": "ok.md", "fixture": "clean.md" }], "args": ["."] },
    { "name": "unreadable-file", "nonRoot": true, "setup": [{ "path": "secret.md", "fixture": "clean.md", "mode": "000" }, { "path": "ok.md", "fixture": "messy.md" }], "args": ["--write", "."] },
    { "name": "corpus-check-json", "setup": [{ "path": "corpus", "copyDir": "fixtures/corpus" }], "args": ["--check", "--json", "corpus"] },
    { "name": "corpus-check-text", "setup": [{ "path": "corpus", "copyDir": "fixtures/corpus" }], "args": ["corpus"] },
    { "name": "corpus-write-text", "setup": [{ "path": "corpus", "copyDir": "fixtures/corpus" }], "args": ["--write", "corpus"] },
    { "name": "corpus-write-strict-quiet", "setup": [{ "path": "corpus", "copyDir": "fixtures/corpus" }], "args": ["--write", "--quiet", "--strict", "--max-line-length", "100", "corpus"] },
    { "name": "corpus-rule-subset-json", "setup": [{ "path": "corpus", "copyDir": "fixtures/corpus" }], "cwd": "corpus/real", "args": ["--json", "--write", "--rule", "MDX004,MDX005,MDX010,MDX042,MDX090", ".", "../edge"] },
    { "name": "preserve-permissions", "setup": [{ "path": "x.md", "text": "#Title\n", "mode": "640" }], "args": ["--write", "x.md"] }
  ]
}
